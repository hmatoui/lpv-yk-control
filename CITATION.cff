cff-version: 1.2.0
title: "LPV-YK Control: Multiple LPV Controllers with Youla-Kucera Parametrization"
message: "If you use this software, please cite both the software and the paper it implements."
type: software
authors:
  - family-names: Atoui
    given-names: Hussam
    affiliation: "Renault SAS"
